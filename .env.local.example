# Copiez ce fichier en ".env.local" (même dossier) et remplacez les valeurs
# ci-dessous par vos vraies clés (voir GUIDE_DEPLOIEMENT.md, Étape 7).
#
# Le fichier ".env.local" est ignoré par Git (.env* dans .gitignore) :
# vos clés ne seront jamais envoyées sur GitHub.

# --- Paiements SEPA (Stripe) ---
# Récupérables dans votre tableau de bord Stripe : Développeurs > Clés API
# Utilisez d'abord les clés "test" (pk_test_... / sk_test_...) pour essayer
# sans risque, puis les clés "live" (pk_live_... / sk_live_...) une fois prêt.
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- Formulaire de contact (Resend) ---
# Récupérable sur resend.com > API Keys (voir GUIDE_DEPLOIEMENT.md, Étape 6).
# Sans cette clé, les formulaires "/contact" et "Inscrire mon CE" affichent
# un message invitant à écrire directement par email (mode démonstration).
RESEND_API_KEY=re_...

# Adresse d'expédition des emails de contact (optionnel).
# Par défaut : "Louvat Box <onboarding@resend.dev>" (fonctionne sans
# configuration). Une fois votre domaine vérifié dans Resend, vous pouvez
# utiliser une adresse de ce domaine, par ex :
# RESEND_FROM_EMAIL=Louvat Box <site@biscuiterie-louvat.com>
RESEND_FROM_EMAIL=

# --- Base de données & comptes clients (Supabase) ---
# Récupérables sur supabase.com > votre projet > Settings > API,
# ou automatiquement via `npx vercel env pull` si le projet est lié à Vercel.
# NEXT_PUBLIC_* : utilisables côté navigateur (clé "anon", publique).
# SUPABASE_SERVICE_ROLE_KEY : SECRÈTE — ne jamais exposer au navigateur,
# utilisée uniquement par les routes /api/admin/* côté serveur.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
